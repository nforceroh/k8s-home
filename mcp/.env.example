# Copy this file to mcp/.env and fill in values for this computer.
# Do not commit mcp/.env.
TRANSPORT=stdio
ENABLE_OTEL=False
SONARRTOOL=True
RADARRTOOL=True
LIDARRTOOL=False
PROWLARRTOOL=True
BAZARRTOOL=False
SEERRTOOL=True
CHAPTARRTOOL=False

SONARR_BASE_URL=https://sonarr.example.invalid
SONARR_TOKEN=replace-with-sonarr-api-key
RADARR_BASE_URL=https://radarr.example.invalid
RADARR_TOKEN=replace-with-radarr-api-key
PROWLARR_BASE_URL=https://prowlarr.example.invalid
PROWLARR_TOKEN=replace-with-prowlarr-api-key
SEERR_BASE_URL=https://seerr.example.invalid
SEERR_API_KEY=replace-with-seerr-api-key

# Retain the approved tool allowlist in your private mcp/.env.
MCP_ENABLED_TOOLS=replace-with-approved-tool-allowlist
